{
  "name": "agent-memory-lifecycle",
  "version": "0.1.0",
  "description": "A deterministic reference implementation for evidence-aware agent memory.",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "check": "pnpm run build && pnpm run lint && pnpm run test"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.34.4",
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "eslint": "^9.22.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.0"
  }
}
